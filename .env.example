# Key NAMES only -- never values. This file is committed.
#
# A real Neon connection string was once pasted in here and pushed to the
# public repo; Neon's scanner found it and the credential had to be rotated.
# `.gitignore` does not protect this file: line 34 is `.env*`, but git keeps
# committing a file it already tracks, so the ignore rule never applied.
#
# Copy to .env.local (which IS ignored) and fill the values there.

# Contact form target (scripts/ and the contact route post to it).
GOOGLE_FORM_URL=

# Neon Postgres, from the Neon console. Analytics only -- see lib/db.ts.
DATABASE_URL=

# Secret input to the daily visitor hash. Must not be guessable: without it an
# IPv4 address is small enough to brute-force out of the digest.
ANALYTICS_SALT=

# Shared secret for /api/cron/*; Vercel Cron sends it as a Bearer token.
CRON_SECRET=

# Password for /admin. The session cookie is signed with a key derived from it,
# so changing this invalidates every existing session.
ADMIN_PASSWORD=

# Claude, for the daily analytics summary and the site chatbot.
ANTHROPIC_API_KEY=
